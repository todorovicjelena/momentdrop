# Supabase — Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_...

# Show "Continue with Google" (enable the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cloudflare R2 — R2 → Manage API tokens (Object Read & Write, bucket: momentdrop)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=momentdrop

# Lemon Squeezy — Settings → API → create key; Store ID i Variant ID sa svakog proizvoda (Premium, Deluxe)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
LEMONSQUEEZY_DELUXE_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
